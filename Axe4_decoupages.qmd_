## Bassin arachidier (21 étudiants)

```{r}

maps$arach<- str_detect(tolower(maps$nom_reg),"arach")
mycol<-"orange"

sel <-maps %>% filter(arach==1)
n<-dim(sel)[1]

leaflet(sen) %>% addProviderTiles(provider = "Stadia.StamenTonerLite") %>% 
