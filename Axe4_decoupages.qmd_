## Sine Saloun (16 étudiants)

```{r}

maps$sine<- str_detect(tolower(maps$nom_reg),"sine")
maps$salou <-str_detect(tolower(maps$nom_reg),"salou")
maps$sine_saloun <- maps$sine | maps$salou
mycol<-"orange"

sel <-maps %>% filter(sine_saloun==1, id !="L1029_4")
n<-dim(sel)[1]

leaflet(sen) %>% addProviderTiles(provider = "Stadia.StamenTonerLite") %>% 
  addPolygons(fillOpacity = 0,
              stroke = mycol,
              weight = 1) %>% 
  addPolygons(data=sel, 
              fillOpacity = 1/n, 
              color = mycol,stroke = TRUE,label = ~id,
              weight=1)
```

## région de Kaolack (8)

```{r}

maps$kaola<- str_detect(tolower(maps$nom_reg),"kaola")
mycol<-"orange"

sel <-maps %>% filter(kaola==1, id != "L1020_5", id != "L1010_3")
n<-dim(sel)[1]

leaflet(sen) %>% addProviderTiles(provider = "Stadia.StamenTonerLite") %>% 
  addPolygons(fillOpacity = 0,
              stroke = mycol,
              weight = 1) %>% 
  addPolygons(data=sel, 
              fillOpacity = 1/n, 
              color = mycol,stroke = TRUE, label = ~id,
              weight=1)
```




## région de Dakar / Cap-Vert  (26)

```{r}

maps$daka<- str_detect(tolower(maps$nom_reg),"daka")
maps$capver <-str_detect(tolower(maps$nom_reg),"cap vert")
maps$dakar_cv <- maps$daka | maps$capver
mycol<-"blue"

sel <-maps %>% filter(dakar_cv==1)
n<-dim(sel)[1]

leaflet(sen) %>% addProviderTiles(provider = "Stadia.StamenTonerLite") %>% 
  addPolygons(fillOpacity = 0,
              stroke = mycol,
              weight = 1) %>% 
  addPolygons(data=sel, 
              fillOpacity = 1/n, 
              color = mycol,stroke = TRUE, label = ~id,
              weight=1)
```

## Région de Casamance (31)

```{r}

maps$casa<- str_detect(tolower(maps$nom_reg),"casa")
mycol<-"darkgreen"

sel <-maps %>% filter(casa==1, id != "L2008_6", id != "L1025_3")
n<-dim(sel)[1]

leaflet(sen) %>% addProviderTiles(provider = "Stadia.StamenTonerLite") %>% 
  addPolygons(fillOpacity = 0,
              stroke = mycol,
              weight = 1) %>% 
  addPolygons(data=sel, 
              fillOpacity = 1/n, 
              color = mycol,stroke = TRUE, 
              label = ~id,highlightOptions = T,
              weight=1)
```

## Région orientale / du Sud Est (23)

```{r}

maps$orient<- str_detect(tolower(maps$nom_reg),"orient")
maps$se1<- str_detect(tolower(maps$nom_reg),"sud-est")
maps$se2<- str_detect(tolower(maps$nom_reg),"sud est")
maps$orient_se <- maps$orient | maps$se1 | maps$se2
mycol<-"purple"

sel <-maps %>% filter(orient_se==1, id != "L2026_5")
n<-dim(sel)[1]

leaflet(sen) %>% addProviderTiles(provider = "Stadia.StamenTonerLite") %>% 
  addPolygons(fillOpacity = 0,
              stroke = mycol,
              weight = 1) %>% 
  addPolygons(data=sel, 
              fillOpacity = 1/n, 
              color = mycol,stroke = TRUE, 
              label = ~id,highlightOptions = T,
              weight=1)
```