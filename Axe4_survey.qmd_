kable(topneg,caption ="Régions les plus répulsives pour les étudiants", col.names = c("Rang","Nom", "Nb. réponses", "% étudiants"), digits=c(0,0,0,1))

```


```{r}
map2 <- left_join(mapreg,topneg)
par(mfrow=c(1,1))
mf_map(map2, type="base", col="lightyellow")
mf_map(map2, type="prop", var="nb",col="blue", inches=0.3, 
