##  Casamance (43 étudiants)

```{r}
library(stringr)
stu$kw<- str_detect(tolower(stu$nom_reg),"casa")
sel <-stu %>% filter(kw==1)
k<-length(sel)

## Check
mf_map(reg, col="lightyellow")
mf_map(sel, 
       col="blue",
       alpha=0.6/k, 
       border="red",
       add=T)
plot(mask$geometry,add=T, col="white", border="white")
mf_map(reg, col=NA, border="black", add=T)
mf_label(reg, var="NAME_1",halo=T)
mf_layout(title = "Noms de région comprenant casa (47 étudiants)",
          credits="Altermap 2026 - Axe 4",
          frame=T,
          scale=T,
          arrow=T)
```


## Sénégal "oriental" (31 étudiants)

```{r}
library(stringr)
stu$kw<- str_detect(tolower(stu$nom_reg),"orient")
sel <-stu %>% filter(kw==1)
k<-length(sel)

## Check
mf_map(reg, col="lightyellow")
mf_map(sel, 
       col="blue",
       alpha=0.6/k, 
       border="red",
       add=T)
plot(mask$geometry,add=T, col="white", border="white")
mf_map(reg, col=NA, border="black", add=T)
mf_label(reg, var="NAME_1",halo=T)
mf_layout(title = "Noms de région comprenant orient* (31 étudiants)",
          credits="Altermap 2026 - Axe 4",
          frame=T,
          scale=T,
          arrow=T)
```




# ANNEXE : CARTES COMMENTEES

```{r}

i<-1
  
 mycode <- mystud[i]
sel <- stu %>% filter(code==mycode)


mf_map(reg)
mf_map(sel, type="typo", var="nom_reg", 
       pal=rainbow(10),  add=T,alpha=0.2,
       leg_pos = NA)
mf_label(sel, var="nom_reg", halo=T)

mf_layout(title = paste("Etudiant", mycode), 
          frame=T,
          scale=T, 
          credits=mysource1,
          arrow=F)

kable(x[i,])

```


