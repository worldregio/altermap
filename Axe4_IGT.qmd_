# B. SENTIMENT D'APPARTENANCE TERRITORIALE

## B.1 Echelle d'appartenance


```{r}
x <- as.factor(donlab$`1st choice`)

x<-case_when(x=="Continent (Afrique)" ~ "6. continent",
             x== "Monde" ~ "7. Monde",
             x== "Département/Arrondissement" ~ "2. Arrdt-Dept",
             x== "Pays (Sénégal)" ~ "4. Pays",
            x==  "Quartier/Village/Commune" ~ "1. Local",
             x==   "Région administrative" ~ "3. Région",
             x== "Sous-région (Afrique de l'Ouest)" ~ "5. sous-continent",
            x=="Autre"~ "8. Autre",
            .default = NA )   



don$ech1 <- as.character(x)

x <- as.factor(donlab$`2nd choice`)
x<-case_when(x=="Continent (Afrique)" ~ "6. continent",
             x== "Monde" ~ "7. Monde",
             x== "Département/Arrondissement" ~ "2. Arrdt-Dept",
             x== "Pays (Sénégal)" ~ "4. Pays",
            x==  "Quartier/Village/Commune" ~ "1. Local",
             x==   "Région administrative" ~ "3. Région",
             x== "Sous-région (Afrique de l'Ouest)" ~ "5. sous-continent",
            x=="Autre"~ "8. Autre",
            .default = NA )   

don$ech2 <- as.character(x)

x<- as.factor(donlab$`3rd choice`)
x<-case_when(x=="Continent (Afrique)" ~ "6. continent",
             x== "Monde" ~ "7. Monde",
             x== "Département/Arrondissement" ~ "2. Arrdt-Dept",
             x== "Pays (Sénégal)" ~ "4. Pays",
            x==  "Quartier/Village/Commune" ~ "1. Local",
             x==   "Région administrative" ~ "3. Région",
             x== "Sous-région (Afrique de l'Ouest)" ~ "5. sous-continent",
            x=="Autre"~ "8. Autre",
            .default = NA ) 
don$ech3 <- as.character(x)
```


### Echelles citées 

On peut tout d'abord examiner quelles échelles ont été les plus mobilisées par les étudiants sans distinguer l'ordre

```{r}
col<-don[,c("ech1","ech2","ech3")] %>% pivot_longer(cols= 1:3)

tab<-table(col$value)
freq(tab,valid = F, total = T) 



par(mar=c(5,5,3,1))
barplot(tab,horiz = T, 
        las=1,
        col=rainbow(13),cex.names = 0.6,
        xlab="nombre d' étudiants ayant cité cette échelle",
        main="Echelles d'appartenance mentionnées",
        sub = mysource,
        cex.sub=0.6)
```


### Echelle citée en premier

On peut ensuite se focaliser sur le premier choix

```{r}

x <-don$ech1

tab<-table(x)
freq(tab,valid = F, total = T) 

par(mar=c(5,5,3,1))
barplot(tab,horiz = T, 
        las=1,
        col=rainbow(13),cex.names = 0.6,
        xlab="nombre d' étudiants citant cette échelle en premier",
        main="Echelles d'appartenance privilégiée",
        sub = mysource,
        cex.sub=0.6)

```

